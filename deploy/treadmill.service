# Rendered and installed by deploy/install.sh (@USER@ and @DIR@ are filled in there).
[Unit]
Description=Treadmill controller web app
After=network.target

[Service]
User=@USER@
WorkingDirectory=@DIR@
Environment=PYTHONPATH=app
ExecStart=/usr/bin/python3 -m treadmill.main
Restart=on-failure
RestartSec=2
# Port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
